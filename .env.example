# Gita environment variables for docker-compose
# Copy this file to .env and customize
#
# SECURITY: Generate a strong JWT secret for production:
#   openssl rand -base64 48
# NEVER commit the .env file to version control!

# =============================================================================
# REQUIRED - Change these for production!
# =============================================================================

# JWT signing secret (64+ random chars). CHANGE THIS!
JWT_SECRET=dev-secret-change-me-in-production

# =============================================================================
# OPTIONAL - Server
# =============================================================================

# Host port mapped to the container's 3000. Change if 3100 is occupied.
GITA_PORT=3100

# Database URL. Points at the bundled postgres service by default; override
# to point at an external Postgres (e.g. for managed DBs or multi-node setups).
DATABASE_URL=postgres://gita:gita@postgres:5432/gita

# PostgreSQL password (matches the bundled postgres service). Change for
# production.
POSTGRES_PASSWORD=gita

# pgvector image. Override if the default is not pullable in your network
# (e.g. use a local mirror). This machine uses:
#   POSTGRES_IMAGE=harbor.pandamicro.com/library/pgvector-pg17:pg17
# POSTGRES_IMAGE=pgvector/pgvector:pg16

# =============================================================================
# OPTIONAL - Embedded SSH server (Git over SSH)
# =============================================================================

# Enable the embedded SSH server inside the gita container. When false (the
# default), the 2222 host port mapping in docker-compose.yml is commented out
# and no SSH listener runs. Set to true AND uncomment the 2222 port mapping in
# docker/docker-compose.yml to expose it.
# GITA_SSH_ENABLED=false

# Host port mapped to the container's SSH port 2222 (only relevant when SSH is
# enabled and the port mapping is uncommented).
# GITA_SSH_PORT=2222

# =============================================================================
# OPTIONAL - Pages (static sites from a repository branch)
# =============================================================================

# GitHub-Pages-style static sites are served at /<owner>/<repo>/ by default.
# Set to false to turn the feature off server-wide.
# GITA_PAGES_ENABLED=true

# Optional URL prefix for all Pages sites, e.g. "/p" serves
# /p/<owner>/<repo>/. Leave empty for the default (no prefix).
# GITA_PAGES_URL_PREFIX=

# =============================================================================
# OPTIONAL - Password reset
# =============================================================================

# No mail transport is wired up, so a password-reset token can only reach the
# user through the API response when this is enabled. Set to true to get the
# token back in the `reset_token` field of the reset request response.
#
# Leave it off in production: the response is uniform for existing and
# non-existent accounts, so returning the token would let an anonymous caller
# both enumerate accounts and take them over.
# GITA_ALLOW_INSECURE_PASSWORD_RESET=false
